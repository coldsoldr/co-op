BR_IMPORT(OPMOD, "fw_screen_raster", 7, 9, FN, 0, "core: R246's raster 0x01A3B490")
BR_IMPORT(OPMOD, "fw_text_new", 7, 9, FN, 0, "core: R246's text ctor 0x01A61904")
BR_IMPORT(OPMOD, "fw_set_text", 7, 9, FN, 0, "core: 0x01A61AAC")
BR_IMPORT(OPMOD, "fw_text_draw", 7, 9, FN, 0, "core: 0x01A6259C")
/* ---- Opus 2: not planned (each refuses the file by name) ---- */
BR_IMPORT(OPMOD, "opus_lfo_register", 0, 0, FN, 0, "an LFO type: coop has no LFO type slot for plugins")
BR_IMPORT(OPMOD, "opus_seq_register", 0, 0, FN, 0, "a sequencer: coop has no sequencer slot for plugins")
BR_IMPORT(OPMOD, "opus_on_knob", 0, 0, FN, 0, "a handler that takes or changes a turn (kennel's bridge refuses it too)")
BR_IMPORT(OPMOD, "opus_on_key", 0, 0, FN, 0, "a key handler before the OS")
BR_IMPORT(OPMOD, "opus_key_post", 0, 0, FN, 0, "posting key events")
BR_IMPORT(OPMOD, "opus_drum_key", 0, 0, FN, 0, "a drum engine (sim): coop engines play in the synth's iter slot only")
BR_IMPORT(OPMOD, "opus_fast_lease", 0, 0, FN, 0, "fast memory: coop_l1_lease is 4 KiB for all engines (dx alone leases 8 KiB)")
BR_IMPORT(OPMOD, "opus_fast_use", 0, 0, FN, 0, "as above")
BR_IMPORT(OPMOD, "opus_on_folder", 0, 0, FN, 0, "a folder on the OP-1's disk (dx's banks)")
BR_IMPORT(OPMOD, "opus_engine_data", 0, 0, FN, 0, "data saved with the sound: coop saves eight words")
BR_IMPORT(OPMOD, "opus_engine_data_set", 0, 0, FN, 0, "as above")

/* ---- R246 addresses kennel's SDK inlines carry (op1_plugin.h, op1_synth.h of hundekraft 3.3.1) ---- */
BR_ADDR(0x0101E5E8, "OP1_SINE_TABLE", "8192 x int16; symbols/sdram.sym")
BR_ADDR(0x019EAD58, "op1_node_set_transform", "coop_scr_transform's target")
BR_ADDR(0x019EB8AC, "node lookup by id", "kennel's opus_art show; R246")
BR_ADDR(0x01A24A4C, "op1_raster_line", "coop_scr_line's target")
BR_ADDR(0x01A28210, "ReadInterface (synth knobs as the screens see them)", "coop_scr_knobs' target")
BR_ADDR(0x01A3B490, "op1_raster", "coop_scr_raster's target")
BR_ADDR(0x01A3B4C8, "op1_screen_draw", "coop_scr_draw's target")
BR_ADDR(0x01A3B580, "op1_find_node", "coop_scr_find's target")
