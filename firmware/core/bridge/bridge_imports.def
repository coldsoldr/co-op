BR_ADDR(0x01A6259C, "op1_text_draw", "R246")
BR_ADDR(0x01AAAC0C, "current synth slot", "R246 data")
BR_ADDR(0x01AB8BA0, "op1_fx_scratch table", "three pointers, R246's own position buffers: the bridge swaps the entry for the right channel")
BR_ADDR(0x01DD7F78, "op1_shift_held", "R246 data")
BR_ADDR(0x01DE5D40, "filter type range table", "0x01DE5C50 + 5 * 0x30: op1_fx_param_q15")
BR_ADDR(0x01DE5D46, "filter type range table +6", "")
BR_ADDR(0x01DE5D4C, "filter type range table +12", "")
BR_ADDR(0x01DE5D52, "filter type range table +18", "")
BR_ADDR(0x01DE5D58, "filter type range table +24", "")
BR_ADDR(0x01DF4E38, "OP1_SCREEN_SLOT", "the instrument slot on screen")
BR_ADDR(0x01DF4E3C, "FX screen edit mode", "0 / 1 / 3")
BR_ADDR(0x01DF6F78, "sample buffers per slot", "uses_sample engines (B8)")
BR_ADDR(0xFF801064, "OP1_VOICE_VEL", "symbols/l1.sym; engine_host.cc VOICE_VEL")
BR_ADDR(0xFF8013C4, "synth knob words", "symbols/l1.sym")
BR_ADDR(0xFF801444, "synth FX knob words", "8 slots x 16 bytes")
BR_ADDR(0xFF8015C4, "drum FX knob words", "")
BR_ADDR(0xFF8016C4, "master FX knob words", "symbols/l1.sym")
BR_ADDR(0xFF8016D4, "current synth slot (audio)", "")
BR_ADDR(0xFF8016D8, "current drum slot (audio)", "")
BR_ADDR(0xFF8016E0, "block counter", "")
BR_ADDR(0xFF801774, "FX output meter", "+ pos * 16: coop's stereo bus may not read it")
BR_ADDR(0xFF801950, "OP1_PITCH_INC", "symbols/l1.sym; engine_host.cc PITCH_INC")
BR_ADDR(0xFF801D50, "OP1_VOICE_ENV", "symbols/l1.sym")
BR_ADDR(0xFF802970, "tape speed", "op1_beat clock inline")
BR_ADDR(0xFF802974, "tape position", "op1_beat clock inline")
BR_ADDR(0xFFB00000, "voice objects", "six x 0x24 in the scratchpad; engine_host.cc VOICE_BASE")
