/*
 * coop's bridge: every name a foreign plugin file may import, and the firmware addresses its code may carry
 * (docs/bridge.md "ABI gap"). One table for the core (core/bridge/bridge_knl.cc, bridge_opmod.cc), the host test
 * (tests/host/bridge) and the survey (tools/bridge/survey.py reads this file as text: keep one entry a line).
 *
 *   BR_IMPORT(dialect, "name", loads, full, kind, shim, "note")
 *     dialect  KNL (a kennel .knl: the ELF name, with Blackfin's underscore) or OPMOD (an Opus 2 .opmod: the plain name)
 *     loads    the bridge phase from which a file importing it LOADS (docs/bridge.md "Plan": B2 kennel effects, B3 their
 *              screens, B4 kennel engines, B5 controls, B6 Opus effects, B7 Opus engines, B8 the big buffers and kennel's
 *              engine extensions). 0 = never: the file is refused with "needs <name>"
 *     full     the phase from which it does what the file expects (between the two a stand-in answers: nothing drawn,
 *              no L1, page 1 only)
 *     kind     FN or DATA (a stand-in function cannot answer a data import)
 *     shim     the bridge's function or object in this tree, or 0 when it needs the core (named in the note)
 *   A name that is not here is refused: "needs <name>". Append; never change what a released core resolved.
 *
 *   BR_ADDR(address, "name", "note")
 *     an R246 address kennel's SDK reaches through a static inline (not an import, so no table catches it): the ones
 *     known to mean the same on coop, where the stock firmware is the OS too. The survey and the audit name every
 *     other firmware-looking constant a file's code builds.
 *
 * Copyright (C) 2026 coldsoldr. GPL-3.0-or-later with the OP-1 firmware permission.
 */

/* ---- kennel: effects (the 19 effect files of hundekraft 3.3.1 import exactly these) ---- */
BR_IMPORT(KNL, "_read_fx_param_safe", 2, 2, FN, 0, "core: the stock read_fx_param 0x01A28DA0 behind coop's fx_sanitize (plugin_host.cc)")
BR_IMPORT(KNL, "_op1_fx_page", 2, 5, DATA, br_op1_fx_page, "uint8 [3][4], page 2 / latch per knob: all 0 (page 1) until B5 maps presses onto coop's controls")
BR_IMPORT(KNL, "_op1_fx_wrap", 2, 5, DATA, br_op1_fx_wrap, "uint8 [3][4], a stepped knob that wraps: written by the file, read by nobody until B5")
BR_IMPORT(KNL, "_op1_l1_claim", 2, 2, FN, br_op1_l1_claim, "0 = no pool: kennel's contract is the same output from the SDRAM copy")
BR_IMPORT(KNL, "_op1_l1_claim_state", 2, 2, FN, br_op1_l1_claim_state, "0 = work on home")
BR_IMPORT(KNL, "_op1_l1_sine_quarter", 2, 2, FN, br_op1_l1_sine_quarter, "0 = use OP1_SINE_TABLE (R246's own, 0x0101E5E8)")
BR_IMPORT(KNL, "_op1_dbg", 2, 2, FN, br_op1_dbg, "empty on the OP-1 by contract")
BR_IMPORT(KNL, "_op1_fx_fast", 2, 8, FN, br_op1_fx_fast, "0 = no lease: the file falls back to op1_fx_big")
BR_IMPORT(KNL, "_op1_sc_source", 2, 8, FN, br_op1_sc_source, "0 and zeros = source not available (ente's sidechain hears nothing)")
BR_IMPORT(KNL, "_op1_fx_big", 8, 8, FN, 0, "a 1 MiB lease per position: more than coop's whole plugin budget (owner decision 3)")
BR_IMPORT(KNL, "_op1_fx_shift", 5, 5, FN, 0, "core: shift + turn into words 5..7, coop's e6 controls")
BR_IMPORT(KNL, "_op1_fx_push_bit", 5, 5, FN, 0, "core: a push toggles a bit of word 7, coop's e6 latch")
/* ---- kennel: screens (GUI thread). From B2 the file loads and plays with the stock filter page: the screen object is
 * never registered, so these are never called; the stand-in answers 0 if one is. From B3 they draw. ---- */
BR_IMPORT(KNL, "_op1_screen_draw_cached", 2, 3, FN, br_stub0, "B3: R246's screen draw 0x01A3B4C8, uncached (coop_scr_draw)")
BR_IMPORT(KNL, "_op1_screen_cached_extra", 2, 3, FN, br_stub0, "B3: the extra static drawing, run every frame")
BR_IMPORT(KNL, "_sq_line", 2, 3, FN, br_stub0, "B3: kennel's seq_text.h raster line, vendored (GPL)")
BR_IMPORT(KNL, "_sq_text", 2, 3, FN, br_stub0, "B3: kennel's stroke text")
BR_IMPORT(KNL, "_sq_num", 2, 3, FN, br_stub0, "B3")
BR_IMPORT(KNL, "_sq_cat", 2, 3, FN, br_stub0, "B3")
BR_IMPORT(KNL, "_sq_dot", 2, 3, FN, br_stub0, "B3")
BR_IMPORT(KNL, "_sq_node_rotate", 2, 3, FN, br_stub0, "B3")
BR_IMPORT(KNL, "_sq_fx_knobs_live", 2, 3, FN, br_stub0, "B3: the shown effect's four knobs, coop_fx_view_t.knobs")
BR_IMPORT(KNL, "_sq_synth_knobs_live", 4, 4, FN, 0, "core: coop_scr_knobs")
/* ---- kennel: engines ---- */
BR_IMPORT(KNL, "_op1_eng_page", 4, 5, DATA, br_op1_eng_page, "uint8 [4], page 2 per knob: all 0 until B5")
BR_IMPORT(KNL, "_op1_engine_knob_steps", 4, 5, FN, br_stub0, "a stepped page-1 knob: turns fine until B5 (strum's pattern selector)")
BR_IMPORT(KNL, "_op1_harmony_context", 0, 0, FN, 0, "kennel's chord / scale features feed it: coop has neither")
BR_IMPORT(KNL, "_op1_input_gain_db", 0, 0, FN, 0, "kennel's input engines (amp, snap, vox): coop has no input engine path")
BR_IMPORT(KNL, "_op1_input_tuner_active", 0, 0, FN, 0, "as above")

/* ---- Opus 2: effects (the kit's opus_plugin.h; the files of the 4.2 starter pack) ---- */
BR_IMPORT(OPMOD, "opus_effect_register", 6, 6, FN, 0, "core: one coop effect per registered type, state per position")
BR_IMPORT(OPMOD, "fw_snprintf", 6, 6, FN, 0, "core: R246's snprintf by address (the kit's op1fw.h)")
BR_IMPORT(OPMOD, "fw_shift_held", 6, 6, FN, 0, "core: coop_scr_mods bit 0")
BR_IMPORT(OPMOD, "opus_fn_held", 6, 6, FN, 0, "core: coop_scr_mods bit 1")
BR_IMPORT(OPMOD, "opus_log", 6, 6, FN, 0, "core: dropped")
BR_IMPORT(OPMOD, "opus_alloc", 6, 6, FN, 0, "core: heap 0 inside the file's budget, from opl_init only")
BR_IMPORT(OPMOD, "opus_sincos", 6, 6, FN, 0, "core: R246's sine table")
BR_IMPORT(OPMOD, "opus_setting", 6, 6, FN, 0, "core: the manifest's default (coop has no settings rows for plugins yet)")
BR_IMPORT(OPMOD, "opus_on_setting", 6, 6, FN, 0, "core: kept, never called")
BR_IMPORT(OPMOD, "opus_accent_now", 6, 6, FN, 0, "core: the stock encoder colour")
BR_IMPORT(OPMOD, "opus_page_now", 6, 9, FN, 0, "the effect's own page: answers nothing to draw")
BR_IMPORT(OPMOD, "opus_page_pixels", 6, 9, FN, 0, "as above")
BR_IMPORT(OPMOD, "opus_page_still", 6, 9, FN, 0, "as above")
BR_IMPORT(OPMOD, "opus_page_still_done", 6, 9, FN, 0, "as above")
BR_IMPORT(OPMOD, "opus_art_text", 6, 9, FN, 0, "art: refused politely (0), the plain page")
BR_IMPORT(OPMOD, "opus_art_ready", 6, 9, FN, 0, "as above")
BR_IMPORT(OPMOD, "opus_art_draw", 6, 9, FN, 0, "as above")
BR_IMPORT(OPMOD, "opus_art_show", 6, 9, FN, 0, "as above")
BR_IMPORT(OPMOD, "fw_screen_draw", 6, 9, FN, 0, "core: R246's screen draw 0x01A3B4C8")
/* ---- Opus 2: engines ---- */
BR_IMPORT(OPMOD, "opus_engine_add", 7, 7, FN, 0, "core: one coop engine per type, six voice blocks")
BR_IMPORT(OPMOD, "opus_engine_live", 7, 7, FN, 0, "core: coop_scr_words")
BR_IMPORT(OPMOD, "opus_engine_knob_set", 7, 7, FN, 0, "core")
BR_IMPORT(OPMOD, "opus_on_main_pass", 7, 7, FN, 0, "core: the main loop's call")
BR_IMPORT(OPMOD, "opus_page_text", 7, 9, FN, 0, "page primitives: nothing drawn until B9")
BR_IMPORT(OPMOD, "opus_page_line", 7, 9, FN, 0, "as above")
BR_IMPORT(OPMOD, "opus_page_frame", 7, 9, FN, 0, "as above")
BR_IMPORT(OPMOD, "opus_page_fill", 7, 9, FN, 0, "as above")
