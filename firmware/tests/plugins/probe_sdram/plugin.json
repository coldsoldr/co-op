{
  "name": "probe_sdram",
  "kind": "synth",
  "symbol": "ENGINE_probe_sdram",
  "sources": [
    "probe_sdram.cc"
  ],
  "sdk_include_dirs": [
    "plugins/probe_common"
  ],
  "defaults": [
    16384,
    16384,
    16384,
    16384
  ],
  "author": "coldsoldr",
  "version": "0.1",
  "description": "m1 test engine (docs/request-rings-collateral.md): 64 cache lines of its own SDRAM a render, read or written, through a 16, 64 or 128 KB region, then a wait to the target cost. Not a real plugin.",
  "controls": [
    {
      "id": "load",
      "name": "load",
      "action": "fn_turn",
      "encoder": "blue",
      "word": 5,
      "kind": "steps",
      "steps": [
        "r 16k",
        "r 64k",
        "r 128k",
        "w 16k",
        "w 64k",
        "w 128k",
        "rs 128k",
        "ws 128k"
      ],
      "default": 0,
      "random": false
    },
    {
      "id": "target",
      "name": "cost",
      "action": "fn_turn",
      "encoder": "green",
      "word": 6,
      "kind": "steps",
      "steps": [
        "25k",
        "12k",
        "37k"
      ],
      "default": 0,
      "random": false
    }
  ]
}
