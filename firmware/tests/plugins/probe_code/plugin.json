{
  "name": "probe_code",
  "kind": "synth",
  "symbol": "ENGINE_probe_code",
  "sources": [
    "probe_code.cc",
    "probe_code_blocks.S"
  ],
  "sdk_include_dirs": [
    "plugins/probe_common"
  ],
  "defaults": [
    16384,
    16384,
    16384,
    16384
  ],
  "author": "coldsoldr",
  "version": "0.1",
  "description": "m1 test engine (docs/request-rings-collateral.md): 4, 8 or 12 KB of straight-line code a render, then a wait to the target cost. Not a real plugin.",
  "controls": [
    {
      "id": "size",
      "name": "code",
      "action": "fn_turn",
      "encoder": "blue",
      "word": 5,
      "kind": "steps",
      "steps": [
        "4 kb",
        "8 kb",
        "12 kb"
      ],
      "default": 0,
      "random": false
    },
    {
      "id": "target",
      "name": "cost",
      "action": "fn_turn",
      "encoder": "green",
      "word": 6,
      "kind": "steps",
      "steps": [
        "25k",
        "12k",
        "37k"
      ],
      "default": 0,
      "random": false
    }
  ]
}
