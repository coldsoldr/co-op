# coop-fw SDRAM symbol map: the plain (unencrypted) OP-1 R246 functions the L1 audio callback drives.
#
# Format: <hex addr> <name> <C|I> <note>. Reverse-engineering annotation; no TE code stored here.
# Identified this session by disassembling the plain SDRAM from the stock image and by the functions
# each one calls (op1fw.h names, fw_* helpers, KeyHandler). The audio callback (symbols/l1.sym
# l1_audio_callback) calls these in block order; see docs/audio-graph.md.

# --- audio output / USB ---
0x019e1a88  l1v_push_interleaved    C  silent/muted-block push to USB (kennel L1_IMM_PATCHES)
0x019e1b3c  l1v_push_lr             C  push master L/R (+ tracks) to USB (kennel L1_IMM_PATCHES); the master audio leaves here
0x019e2f24  fw_midi_out_drain       C  calls fw_midi_send (0x019e0d18) + fw_usb_configured: drains queued MIDI to USB

# --- the FX stage (the hook for two FX slots per position) ---
0x01a88028  set_indicator           C  RETRACTED earlier "fx_render_position": this sets a 0..5 level indicator (state byte 0x18c23b0); the 3 callsites are if/elseif/else on level word 0xff80108a, gated ~every 20 blocks, NOT FX positions
# --- real FX render: object/vtable dispatch inside 0xffa00e50 (L1), confirmed ---
0xffa00e50  l1_fx_render            C  the FX render driver (synth/drum mono, master stereo); master render call at 0xffa017e6
0x1aaad68   d_master_fx_instance    C  master FX instance ptr; vtable=*instance, render=*(vtable+0x14), state=instance+*(u16*)(vtable+0x10)
0x1aaad30   d_fx_instance_table     C  type -> instance registry (table[type]); init via vtable+0x24 (0x1967308), param via vtable+0x1c
0x1aaac40   d_master_fx_enable      C  master FX enable byte (render gated on it)
0xff800d34  d_master_bus_L          C  master bus L, 64 x int16
0xff800db4  d_master_bus_R          C  master bus R, 64 x int16 (0x80 after L)
0xff801734  d_synth_fx_type         C  synth FX type array [+slot*4] (read 0xffa029ec)
0xff801754  d_drum_fx_type          C  drum FX type array [+inst*4] (read 0xffa01c68)
0x018dd7d4  d_fx_name_table         C  stock effect name strings: delay/grid/punch/phone/spring/nitro
0x01a8e340  tape_cache_io           C  calls fw_yaffs_pread (0x01a99ca8) + fw_yaffs_close: tape chunk streaming from the tape file

# --- input: key/encoder scan and queue (runs at the END of the audio ISR, not audio DSP) ---
0x019ae7cc  key_bank_scan           I  reads key banks 0x23..0x26 (lfo-interface/screen docs); input, not audio
0x019c2f24  KeyHandler_PushKey      C  queues a key event into s_key_queue (te-op1-cfw screen docs)
0x019c2f04  fw_post_keyhandler      C  wakes the KeyHandler thread (op1fw.h)
0x019c3044  KeyHandler_AddKnob      C  adds an encoder delta to s_knob_acc[4] (te-op1-cfw screen docs)

# --- early-block stages (not yet pinned; call alloc/USB helpers) ---
0x0193ee7c  cb_stage_input          I  first callback stage; calls TLSF free (0x1a5e310) + 0x1aa2b14/324a
0x019e193c  cb_stage_usb            I  calls fw_usb_configured (0x1a69360) + 0x1a0dc7c/0x1aa494a

# --- shared helpers (named in te-op1-cfw docs / op1fw.h) ---
0x01919aa8  fw_assert_handler       C  assert/panic handler (lfo-interface.md)
0x019e0d18  fw_midi_send            C  USB MIDI out (op1fw.h)
0x01a69360  fw_usb_configured       C  USB-configured check (op1fw.h)
0x01a99ca8  fw_yaffs_pread          C  yaffs pread (op1fw.h)
0x01a99908  fw_yaffs_close          C  yaffs close (op1fw.h)
0x01a5e310  fw_tlsf_free            C  TLSF pool free wrapper (memory-map.md)

# --- voice bus / mix path, confirmed dynamically with the op1emu write tracer (docs/stereo-bus.md, 2026-11-01) ---
0x019674f8  dc_block_voice_bus      C  CORRECTED 2026-11-02 (was "decimate_voice_bus_end"): a 64-sample first-order DC blocker, not a decimator. Reads the decimated 64 at 0xff801e50 (I0), y = sat(sat(y - Xprev) + X) - c*Yq, c = live word 0x01bab53c, state 3 words at 0x01aaac14; writes 64 int16 over 0xff800bb4..0xff800c32 (stores 0x01967586/0x0196759a/0x019675d2/0x0196760e), RTS 0x01967612. coop replica: coop_dc_block
0x01a66b80  drum_sdram_sample_wr    C  drum engine sample path: one W[I0++] = R3.H store per call into the voice bus (32x16 fractional interpolation before it)
0x019de5a8  postmix_mono_add        C  LSETUP(0x019de5ac,0x019de5e8): adds one mono term (A0/A1 generator) to d34 (0x019de5d4) and db4 (0x019de5cc) in place after the mix loops; term was zero in play (metronome/click?) [I]

# --- master output path (2026-11-01, write tracer) ---
0x019d90e8  master_level_getter     C  `R0 = 0xff80187c; RTS`: called via CALL (P1) at 0xffa017ac right before the stock level stage; the coop master stage (coop_master_apply) replaces THIS and returns the same value
0x019d90f2  master_level_sdram_copy I  an SDRAM copy of the 0xffa04280 level stage (same prologue on 0xff801880); not in the live path

# --- voice path inputs, confirmed with the write tracer 2026-11-02 (docs/stereo-bus.md) ---
0x01a52040  synth_engine_default    C  the default patch's synth render (sine wavetable 0x0101e5e8): scratch to 0xff801e50 (0x01a520c6), output to R1 = 0xff80113c (0x01a52136..0x01a521d2)
0x01912252  adsr_fill_env           C  SDRAM ADSR: writes the 128-entry per-voice envelope 0xff801d50 before each synth render (also 0x01912300, 0x01912478 paths)
0x01b4ef6e  d_voice_sum_gain        C  int16 gain word read by the synth sum (W[P4]), the drum sum (W[P5]) and mix loop B (R0.L): 0x6000 at run time (written once as 0x60000000 at 0x01b4ef6c by 0x01a552c2)
0x0106a6f0  d_hb_coefs              C  32 x int16 even-phase taps of the L1 half-band decimator (zero in the LDR image: filled at run time; coop reads them live)
0x01bab53c  d_dc_coef               C  int32 coefficient of the SDRAM DC blocker (run-time value; coop reads it live)
0x01aaac14  d_dc_state              C  3 state words of the SDRAM DC blocker (X prev, Yq prev, y prev)
0x018b621d  d_output_mode           C  byte: 0 = speaker (SPORT conversion sums e34+f34 to mono, 0xffa01698), nonzero = headphones/line out (stereo paths 0xffa0142a/0xffa015f0). Set 1 by the event case at 0x019ac964 [I: jack detection]; op1emu leaves it 0

# --- tape path (write tracer, record + play, 2026-11-02; docs/tape-stereo.md) ---
0x01b5ef84  d_tape_play_L           C  600 x int16 L play buffer: 4-track pan mix (L1 0xffa07164) -> resampler (0xffa06194) -> d34
0x01b5f434  d_tape_play_R           C  600 x int16 R play buffer (0xffa0716c) -> db4
0x01b5f8f4  d_tape_rec_buf          C  600 x int16 mono record buffer: 0xffa06248 writes it (store 0xffa062f6) every block while recording; the overdub loop reads it
0x02040000  d_big_array_02040000    C  7.94 MB array: NOT the tape cache (0 stores during record + play); role open
0x01b4ef34  tape_c                  C  tape cache object (L1 P5 base): +0/+4 loop in/out, +8 list head 0x01b4ef3c, +0xc tail, +0x10 fd, +0x14 chunk directory (int32[485]), +0x3a W gain, +0x40 running, +0x44 level ramp, +0x48 4 seam staging buffer pointers
0x01a54168  tape_cache_init         C  builds 24 nodes (28 B each, 0x1a5e3b0) with 256 KiB data blocks (malloc 0x1a9f348, heap 0), the 1940 B chunk directory and the 4 x 0x4a4 seam buffers (0x01a54124)
0x01a54d5c  tape_cache_lookup       C  (pos, &dir): chunk = pos >> 15, directory then list search on W[node+6], move-to-front, prefetch chunk-1..chunk+1 via 0x01a54cd4; returns the node (0 = not loaded)
0x01a54bb4  tape_rec_node_lookup    C  record-side chunk lookup used by l1_tape_record (loop-aware, 0xff8029ec flag); result kept at 0x018c17ec
0x0107d034  d_tape_cache_nodes      C  24 cache nodes, stride 0x28: B+0 valid, B+2 flush req, W+4 dirty mask (bit/track), W+6 chunk, +0xc start sample, +0x10 data (track t at +t*0x10000), +0x14 next, +0x18 prev
0x018c17d8  d_tape_rec_state        C  +0 recording byte, +4 record resampler phase, +0x14 record node, +0x18 W seam mask, +0x1c B seam valid
0x018c1810  d_tape_track_base       C  int32[4] file offsets of the track data in tape_c.raw (filled at mount; kennel TRACK_BASE)
