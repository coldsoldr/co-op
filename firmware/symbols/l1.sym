# coop-fw L1 symbol map: the decrypted OP-1 R246 audio core (L1 instruction SRAM 0xffa00000).
#
# Format: <hex addr> <name> <C|I> <note>   (C = confirmed from the decrypted bytes / research;
# I = inferred). Reverse-engineering annotation only; no Teenage Engineering code is stored here.
# Derived this session from the decrypted region plus te-op1-cfw interface docs, opus-kit op1fw.h
# and kennel's make_firmware.py L1 tables. Expand as functions are analysed.

0xffa00000  l1_crt0                 C  event-vector loads then crt0; SP=0xff803fb0 at 0xffa00054
0xffa009a0  l1_voice_loop           C  the Core voice loop (engine-interface.md); near the pitch-array setup
0xffa00ad4  l1_lfo_dispatch         C  per-voice LFO: loads the voice LFO ptr, checks lfo_active, CALL [vt+0x14]
0xffa01018  l1v_metro               C  metronome render (kennel L1_IMM_PATCHES l1v_metro)
0xffa04804  l1_audio_callback       C  audio DMA callback / graph driver (kennel sm_audio_cb target); times with CYCLES, CLI, many vtable dispatches
0xffa036c4  l1_cb_sub_036c4         I  direct callee of the audio callback; sets up 4-wide state at 0xff801870
0xffa017ec  l1_cb_sub_017ec         I  direct callee of the audio callback; CLI, state at 0xff802618
0xffa0487c  l1v_push_interleaved    C  muted-output silent block push (kennel L1_IMM_PATCHES)
0xffa049fc  l1v_push_lr             C  push master L/R (+ tracks) to USB (kennel L1_IMM_PATCHES)
0xffa0619a  l1_tape_resampler       C  tape resampler prologue (kennel L1_CALLS l1v_rs_probe)
0xffa0709c  l1_mix_max_fwd          C  mix loop 1: R0 = MAX(R2,R0) meter op (kennel L1_PCCALLS)
0xffa0712c  l1_mix_max_rev          C  mix loop 2: R0 = MAX(R0,R1) meter op (kennel L1_PCCALLS)

# L1 data (0xff800000 / 0xff900000): live words the audio core reads/writes (te-op1-cfw memory-map.md,
# lfo-interface.md). Addresses, not contents.
0xff801950  d_pitch_inc             C  128 x u32 per-sample phase increments (voice pitch)
0xff801d50  d_voice_gain            C  128 x int16 voice gain array
0xff801724  d_knob_scratch          C  8 x int16 engine-knob scratch (LFO/render params)
0xff801064  d_voice_velocity        C  per-voice velocity
0xff801928  d_mixer                 C  mixer subscreen 0 settings
0xff8017cc  d_eq                    C  master EQ settings (4 int16)
0xff8016c4  d_fx                     C  master FX settings
0xff80189c  d_comp_drive            C  master compressor/drive settings (4 int16; L1 reads the float vector at 0x1ab333c)

# --- voice path (confirmed this session) ---
0xffa009a0  l1_voice_loop_body      C  voice loop: per-voice LFO (0xffa00ad4), render/env, sum to mono bus; reads knob scratch 0xff801724, gain 0xff801d50, LFO params 0xff8014c4, per-voice LFO objs 0x1aaad6c, Core 0x1aaac0c
0xffa02798  l1_voice_loop_caller    C  calls l1_voice_loop_body
0x0191264c  fw_voice_process        I  SDRAM helper called from the voice loop (render or envelope path)
0xff8013c4  d_adsr                  I  per-slot ADSR scratch (voice loop reads it)

# --- audio buffer bank + master stage (synthesized from 3 RE passes, 2026-11-01) ---
0xffa00e50  l1_master_stage         C  the mixer + comp + drive + per-track pan-mix stage (recursive node renderer); downmixes to codec + meter; the master-suite seam
0xffa0143a  l1_master_downmix_read  C  reads e34/f34 (the USB-audio bus) in a CONDITIONAL branch; NOT the speaker path in the tested config (e34/f34 are zero without a USB-audio host)
0xffa017ae  l1_master_comp_call     C  CALL (stock 0xffa04280) that our master suite + FX slot retarget (runs every block); preceded by the coeff build CALL 0x019d90e8 at 0xffa017ac
0xffa04280  l1_master_comp_level    C  master COMPRESSOR/level DSP (NOT EQ): own frame (SP-=0x28), operates on 0xff801880 comp state; this is the stage the coop master suite replaces (item 11). Earlier "EQ biquad writing e34/f34" label was WRONG
0xffa017e6  l1_master_fx_render     C  master FX vtable render: CALL (P0), P0=*(instance+0x14), handed d34 (0xff800d34, in R1/P2) and db4 (0xff800db4, in P0/R2) -> confirms d34/db4 are the live master bus
0x019d91ea  fw_eq_coeff_build       C  SDRAM: builds EQ coeffs 0xff801b50 from d_eq 0xff8017cc (replace/stop if replacing EQ)
0xff800d34  d_master_L              C  MASTER LEFT, 64 x int16, planar (db4 = +0x80). THE live codec/speaker master bus -- carries audio (op1emu probe: non-zero under a chord, read by the FX render + mix loop 0xffa072c8). The coop master suite + FX operate here.
0xff800db4  d_master_R              C  MASTER RIGHT, 64 x int16, 0x80 after L. See d_master_L.
0xff800e34  d_usb_audio_L           I  USB-audio stream bus L, int32 (read/written by fw_usb_audio_stream 0x01915608). ZERO when no USB-audio host is streaming (op1emu probe: 0/36341 under a chord). NOT the speaker master -- earlier "MASTER LEFT Q31" label was WRONG.
0xff800f34  d_usb_audio_R           I  USB-audio stream bus R, int32, 0x100 after L. See d_usb_audio_L.
0xffa072c8  l1_master_mix_read      C  mix/downmix loop reading d34/db4 (W[I0]/W[I1], int16) -> the output/meter path for d34/db4
0xff800bb4  d_voice_bus_mono        C  mono voice-accumulate bus, 88.2 kHz, 128 x int16 (voice loop writes it; also read for metering/scope)
0xff800770  d_codec_tx              C  SPORT0 TX DMA buffer (int16 interleaved, 64 frames, ping-pong 0xff800970); the DAC/speaker output
0xff800b74  d_codec_tx_live         C  cached pointer to the live TX half (SPORT ISR 0xffa004fe)
0xff801b50  d_eq_coeffs             C  master EQ coefficients (built by fw_eq_coeff_build)
0xff8018b4  d_comp_drive_gains      C  comp/drive gains region (near d_comp_drive 0xff80189c; float vec 0x01ab333c via loader 0x01a29d30)
0x019e193c  fw_usb_in_resampler     C  SDRAM: USB audio input resampler (reads ring 0x01aadb60)
0x01915608  fw_usb_audio_stream     C  SDRAM: bidir USB audio stream, reads/writes e34/f34 by state
0xff800370  d_sport_rx_desc         C  SPORT0 RX DMA descriptor base (0x0191ab40 sets up SPORT DMA)

# --- voice bus / mix path, confirmed dynamically with the op1emu write tracer (docs/stereo-bus.md, 2026-11-01) ---
0xff800bb4  d_voice_bus             C  mono voice bus: 128 x int16 @ 88.2 kHz after the per-voice sums; first 64 overwritten in place by the SDRAM decimator (sdram.sym)
0xffa06a48  l1_master_clear         C  per-block clear of d34/db4 (LSETUP x32, int32 stores at 0xffa06a48 L / 0xffa06a4a R); first writer in the block
0xffa01d1e  l1_voice_bus_clear      C  per-block clear of the voice bus (LSETUP x64 int32)
0xffa00d28  l1_synth_render_call    C  CALL (P2), P2 = *(vtable+0x14): synth voice render; followed by the synth accumulate
0xffa00d46  l1_synth_accum_loop     C  LSETUP(0xffa00d4a,0xffa00d62) LC0=127: bus[i] = sat(bus[i] + render[i]*ramp[i]*gain), ramp P5=[SP+0x38], gain W[P4]; stores 0xffa00d5a (body) + 0xffa00d70 (last); bus imm at 0xffa00d2e/0xffa00d32
0xffa00d7c  l1_synth_voice_meter    C  R0 = MAX(R0,R1)(V) -> [P0+0x40] after the accumulate
0xffa00904  l1_drum_render_call     C  CALL (P0), P0 = *(vtable+0x24), param W[vtable+0x20]: drum voice render
0xffa00922  l1_drum_accum_loop      C  LSETUP(0xffa00926,0xffa0093e) LC0=128: bus[i] = sat(bus[i] + sat(2*render[i]*gain)), gain W[P5]; store 0xffa0093e; bus imm at 0xffa00912/0xffa00916. Runs only in drum mode
0xffa00f2c  l1_mix_loop_a           C  LSETUP(0xffa00f30,0xffa00f86) x64: 64 decimated bus samples * L gain R0.H / R gain R2.H * R6.L + peak meters -> d34 (0xffa00f76) / db4 (0xffa00f7e). WROTE ZERO in every block (chord and drum): the silent "global pan"
0xffa00fae  l1_mix_loop_b           C  LSETUP(0xffa00fb2,0xffa00fda) x64: same 64 samples * gain R0.L * ramped W[P1] added EQUALLY to d34 (0xffa00fca) and db4 (0xffa00fd2): the active mono-to-master path
0xffa033c0  l1_master_level_wr_L    C  master level stage writes L back in place (64 stores/block; after the SDRAM post-mix). Body of the 0xffa04280 stage [I on identity]
0xffa03590  l1_master_level_wr_R    C  master level stage writes R back in place (64 stores/block)

# --- master output path, confirmed with the write tracer + --audio-dump (docs/audio-graph.md second correction, 2026-11-01) ---
0xffa017a4  l1_master_getter_imm    C  P1.L/P1.H = 0x019d90e8 (SDRAM getter), CALL (P1) at 0xffa017ac, then CALL 0xffa04280 at 0xffa017ae: the coop master stage stands in for the getter (l1_insert.py --imm-pair-site)
0xffa044e0  l1_master_level_out_L   C  inside 0xffa04280: writes the int32 output bus e34 (0xff800e34), 64/block, from d34 with the master level/comp
0xffa046f0  l1_master_level_out_R   C  inside 0xffa04280: writes f34 (0xff800f34) likewise
0xffa0171c  l1_sport_tx_convert     C  LSETUP(0xffa01720,0xffa0178e): reads e34 (I1) and f34 (P5) int32, soft-limits (0x7bb8/-0x3472 polynomial) and writes the SPORT TX ring as interleaved 32-bit frames ([I0 ++ M0=8] at 0xffa0173e; last at 0xffa0179e); zero when e34/f34 are unwritten
0xff800e34  d_master_out_L          C  master OUTPUT bus L, 64 x int32: written by 0xffa04280, read by the SPORT TX conversion and the USB stream. NOT "USB only" and NOT always zero (a block-start probe saw it before the stage ran)
0xff800f34  d_master_out_R          C  master OUTPUT bus R, 64 x int32
0xff800770  d_sport_tx_ring         C  SPORT TX DMA ring (DMA1, descriptor list at 0xff800b70, START 0xff800770, 128 x 32-bit words per buffer), what the codec plays

# --- decimator / output path, confirmed with the write tracer 2026-11-02 (docs/stereo-bus.md) ---
0xffa005d4  l1_hb_decimate          C  half-band decimator 128 -> 64: voice bus (P2 = 0xff800bb4, 32-bit words = 2 samples) into even/odd rings 0xff80123c/0xff80127c (L2=L3=0x40), acc = odd[16 back]*0.5 + 32 (W32) MACs over taps 0x0106a6f0, out = (acc>>16)*ramp, ramp word 0xff80107c (.L ramp .H step, written back 0xffa0067e); 64 int16 to 0xff801e50 (store 0xffa0066e). coop replica: coop_hb_decimate
0xff801e50  d_decim_out             C  64 x int16 decimator output (also the default engine's 128-sample render scratch earlier in the block); the DC blocker's input
0xff80113c  d_voice_render_out      C  128 x int16 synth/drum render output (R1 of the vtable render; 0xffa009de / 0xffa0068c)
0xff801d50  d_voice_env             C  128 x int16 per-voice envelope (ADSR output), multiplied with the render in the synth sum. (Earlier "voice gain array" label was this.)
0xff80107c  d_hb_ramp               C  decimator volume ramp word: .L ramp (0x1000 at boot -> 0x7fff), .H step (0x40, written each block at 0xffa030b8)
0xffa0140c  l1_sport_mode_test      C  reads the output-mode byte 0x018b621d: 0 -> mono (speaker) conversion 0xffa01698, else stereo conversion 0xffa0142a / 0xffa015f0 (both SPORT words written: 0xffa01642 L, 0xffa01662 R)
0xffa01698  l1_sport_convert_mono   C  (e34 + f34)/2, soft limit, one word per 8-byte SPORT frame (0xffa0173e): the speaker path; what op1emu runs
0xffa01636  l1_sport_convert_stereo C  LSETUP(0xffa0163a,0xffa0167e): L -> frame word 0 (0xffa01642), R -> word 1 (0xffa01662), DC offset bit 22
0xffa0bfb4  l1_coop_tramps          C  coop stereo-bus trampolines (tools/l1_stereo_insert.py): synth +0, drum +12, mix +24 (40 bytes of kennel's free .l1tramp range)

# --- tape path, confirmed with the write tracer on a record + play scenario 2026-11-02 (docs/tape-stereo.md) ---
0xffa06194  l1_tape_play_resample   C  per block: 16-tap polyphase resampler (coefs 0xff802154, 16 x 64) over the L/R play buffers 0x01b5ef84 / 0x01b5f434 (600 samples each), x gain ramp, writes ALL 64 of d34 (0xffa06232) and db4 (0xffa0622a): the tape play output is already stereo
0xffa0714c  l1_tape_track_mix       C  LSETUP(0xffa0714c,0xffa0716c): per track L[i] += gL*s (0xffa07164), R[i] += gR*s (0xffa0716c) into the play buffers, gL = W[P0], gR = W[P0+8] per-track gain record; cleared at 0xffa06ede. The 4-mono-track pan mix a stereo track replaces
0xffa072c4  l1_tape_level           I  in-place per-sample level/one-pole stage on d34/db4 right after the resampler (stores 0xffa0730c L / 0xffa07304 R)
0xffa06248  l1_tape_rec_resample    I  mono resampler 0xff8029e4 -> 0x01b5f8f4 through the same coefs; did NOT run as the record path in the traced scenario
0xff802154  d_tape_interp_coefs     C  16 x 64 int16 polyphase interpolation table (written once at boot by 0x01a53ca2)
0xff8029dc  d_tape_phase            C  tape position/phase words (0xffa06886, 0xffa06a18, 0xffa06388 write them)
0xffa00f2c  l1_mix_loop_a           C  (addendum) nonzero only while the tape runs: its L/R gains come alive in tape mode
