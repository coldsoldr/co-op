 gui/audio_output_wav.h   | 31 +++++++++++++++
 gui/main.cpp             | 19 +++++++++-
 src/cpu/emu.cpp          |  1 +
 4 files changed, 132 insertions(+), 1 deletion(-)
 create mode 100755 gui/audio_output_wav.cpp
 create mode 100755 gui/audio_output_wav.h

diff --git a/gui/audio_output_wav.cpp b/gui/audio_output_wav.cpp
new file mode 100755
index 0000000..b75123f
--- /dev/null
+++ b/gui/audio_output_wav.cpp
@@ -0,0 +1,82 @@
+#include "audio_output_wav.h"
+
+#include "utils/log.h"
+
+#include <cstring>
+#include <vector>
+
+namespace {
+constexpr uint32_t kRate = 44100;
+constexpr uint16_t kChannels = 2;
+
+void Put16(uint8_t* p, uint16_t v) { p[0] = uint8_t(v); p[1] = uint8_t(v >> 8); }
+void Put32(uint8_t* p, uint32_t v) { Put16(p, uint16_t(v)); Put16(p + 2, uint16_t(v >> 16)); }
+}  // namespace
+
+WavAudioOutput::WavAudioOutput(const std::string& path) : path_(path) {
+    file_ = fopen(path.c_str(), "wb");
+    if (!file_) {
+        LogError("Audio dump: cannot write %s", path.c_str());
+        return;
+    }
+    WriteHeader(0);
+    LogInfo("Audio dump: %s (16-bit stereo WAV, %u Hz)", path.c_str(), kRate);
+}
+
+WavAudioOutput::~WavAudioOutput() {
+    if (!file_) return;
+    WriteHeader(static_cast<uint32_t>(frames_ * kChannels * 2));
+    fclose(file_);
+    LogInfo("Audio dump: %llu frames (%.2f s), %llu nonzero, to %s", static_cast<unsigned long long>(frames_),
+            frames_ / double(kRate), static_cast<unsigned long long>(nonzero_), path_.c_str());
+}
+
+void WavAudioOutput::WriteHeader(uint32_t dataBytes) {
+    uint8_t h[44];
+    memcpy(h, "RIFF", 4);
+    Put32(h + 4, 36 + dataBytes);
+    memcpy(h + 8, "WAVEfmt ", 8);
+    Put32(h + 16, 16);
+    Put16(h + 20, 1);  // PCM
+    Put16(h + 22, kChannels);
+    Put32(h + 24, kRate);
+    Put32(h + 28, kRate * kChannels * 2);
+    Put16(h + 32, kChannels * 2);
+    Put16(h + 34, 16);
+    memcpy(h + 36, "data", 4);
+    Put32(h + 40, dataBytes);
+    fseek(file_, 0, SEEK_SET);
+    fwrite(h, 1, sizeof h, file_);
+    fseek(file_, 0, SEEK_END);
+}
+
+void WavAudioOutput::WriteSamples(const void* data, size_t samples, int channels, int bitsPerSample, bool stereo) {
+    if (!file_ || samples == 0 || channels <= 0) return;
+    if (!formatLogged_) {
+        formatLogged_ = true;
+        LogInfo("Audio dump: SPORT frames of %d word(s) x %d bits, %s", channels, bitsPerSample,
+                stereo ? "stereo frame sync" : "no stereo frame sync");
+    }
+    const bool wide = bitsPerSample > 16;
+    const size_t wordBytes = wide ? 4 : 2;
+    const uint8_t* src = static_cast<const uint8_t*>(data);
+    std::vector<uint8_t> out(samples * 4);
+    auto word = [&](size_t frame, int index) -> int16_t {
+        const uint8_t* p = src + (frame * channels + index) * wordBytes;
+        if (!wide) {
+            return static_cast<int16_t>(uint16_t(p[0] | (p[1] << 8)));
+        }
+        uint32_t v = uint32_t(p[0]) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+        v <<= (32 - bitsPerSample);  // right-justified word to the top of 32
+        return static_cast<int16_t>(static_cast<int32_t>(v) >> 16);
+    };
+    for (size_t i = 0; i < samples; ++i) {
+        const int16_t l = word(i, 0);
+        const int16_t r = (stereo && channels >= 2) ? word(i, 1) : l;
+        Put16(&out[i * 4], uint16_t(l));
+        Put16(&out[i * 4 + 2], uint16_t(r));
+        if (l != 0 || r != 0) ++nonzero_;
+    }
+    fwrite(out.data(), 1, out.size(), file_);
+    frames_ += samples;
+}
