     while (length > 0) {
         Device* dev = Find(addr);
         if (!dev) {
@@ -88,6 +92,7 @@ void Emulator::MemoryWrite(u32 addr, const void* buffer, int length)
             length -= len;
         }
     }
+    if (total > 0) Trace(start, u32(total), data);
 }
 
 bool Emulator::Maps(u32 addr, u32 length)
@@ -155,6 +160,7 @@ void Emulator::MemoryWrite32(u32 vaddr, u32 value)
             dev->Write32(offset, value);
         }
     }
+    Trace(vaddr, 4, &value);
 }
 
 void Emulator::MemoryWrite64(u32 vaddr, u64 value)
@@ -166,7 +172,32 @@ bool Emulator::MemoryWriteExclusive32(u32 vaddr, u32 value, u32 expected)
 {
     Watch(vaddr, 4);
     auto atomic = (std::atomic<u32>*)MemoryMap(vaddr);
-    return atomic->compare_exchange_strong(expected, value);
+    const bool stored = atomic->compare_exchange_strong(expected, value);
+    if (stored) Trace(vaddr, 4, &value);
+    return stored;
+}
+
+void Emulator::AddWriteTrace(u32 lo, u32 hi, WriteTrace trace)
+{
+    assert(lo <= hi);
+    writeTraces_.push_back({lo, hi, std::move(trace)});
+    RebuildDirectPages();
+}
+
+bool Emulator::Traced(u32 first, u32 last) const
+{
+    for (const auto& range : writeTraces_)
+        if (range.lo <= last && first <= range.hi) return true;
+    return false;
+}
+
+void Emulator::TraceAccess(u32 addr, u32 length, const void* value)
+{
+    const u32 last = u32(std::min<u64>(u64(addr) + length - 1, 0xFFFFFFFF));
+    u32 word = 0;
+    memcpy(&word, value, std::min<u32>(length, 4));  // little-endian host, as the guest
+    for (const auto& range : writeTraces_)
+        if (range.lo <= last && addr <= range.hi) range.trace(addr, length, word);
 }
 
 void* Emulator::MemoryMap(u32 addr)
@@ -203,6 +234,7 @@ void Emulator::RebuildDirectPages()
             if (other) continue;
             if (readHooks.lower_bound(first) != readHooks.upper_bound(last)) continue;
             if (writeHooks.lower_bound(first) != writeHooks.upper_bound(last)) continue;
+            if (Traced(first, last)) continue;
             directPages[page >> PAGE_BITS] = static_cast<u8*>(dev->Map(first - dev->BaseAddress()));
         }
     }
diff --git a/src/cpu/emu.h b/src/cpu/emu.h
index 972e95a..a959dc5 100644
--- a/src/cpu/emu.h
+++ b/src/cpu/emu.h
@@ -78,6 +78,21 @@ public:
     void AddReadHook(u32 addr, std::function<u32(u32)> hook) { readHooks[addr] = hook; RebuildDirectPages(); }
     void AddWriteHook(u32 addr, std::function<void(u32, u32)> hook) { writeHooks[addr] = hook; RebuildDirectPages(); }
 
+    // A write trace sees every store that lands in [lo, hi] (inclusive) after
+    // it reached memory: the address stored to, the width in bytes and the
+    // value (little-endian; the first four bytes of a longer host write, as
+    // DMA's or the LDR loader's). Unlike a write hook it replaces nothing,
+    // covers every width (hooks only see 32-bit stores) and may span a
+    // range; several traces may overlap. The pages it covers stop being
+    // direct (DirectPages()), so generated code calls back here for each
+    // access to them, and the storing instruction's PC can be read from the
+    // CPU state inside the trace (bcore materializes pc before every memory
+    // callback). The trace runs on the thread that stores and must not write
+    // a guest register (as a hook: Memory::callbacks_preserve_registers()).
+    using WriteTrace = std::function<void(u32 addr, u32 length, u32 value)>;
+    void AddWriteTrace(u32 lo, u32 hi, WriteTrace trace);
+    bool TracesWrites() const { return !writeTraces_.empty(); }
+
     // The guest pages generated code may load from and store to directly
     // (bcore's Memory::page_table()): one entry per page, the host address of
     // its first byte, or null where an access must come through the device
@@ -143,6 +158,12 @@ protected:
         if (watcher_) WatchAccess(addr, length);
     }
     void WatchAccess(u32 addr, u32 length);
+    // After a store of length bytes at addr: the write traces it lands in.
+    void Trace(u32 addr, u32 length, const void* value) {
+        if (!writeTraces_.empty()) TraceAccess(addr, length, value);
+    }
+    void TraceAccess(u32 addr, u32 length, const void* value);
+    bool Traced(u32 first, u32 last) const;
 
     std::shared_ptr<FastMem> fastmem;
     std::shared_ptr<std::array<u8*, NUM_PAGE_TABLE_ENTRIES>> pageTable;
@@ -150,6 +171,11 @@ protected:
     std::vector<Device*> devices;
     std::map<u32, std::function<u32(u32)>> readHooks;
     std::map<u32, std::function<void(u32, u32)>> writeHooks;
+    struct WriteTraceRange {
+        u32 lo, hi;
+        WriteTrace trace;
+    };
+    std::vector<WriteTraceRange> writeTraces_;
     std::vector<u8*> directPages;
     // WatchPages(): the watcher (null while it watches nothing), its pages,
     // and what each page's DirectPages() entry is without the watch.
-- 
