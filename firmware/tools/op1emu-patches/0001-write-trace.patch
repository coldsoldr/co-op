diff --git a/gui/write_watch.cpp b/gui/write_watch.cpp
new file mode 100755
index 0000000..f527a19
--- /dev/null
+++ b/gui/write_watch.cpp
@@ -0,0 +1,132 @@
+#include "write_watch.h"
+
+#include "cpu/cpu.h"
+#include "cpu/time_source.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <stdexcept>
+
+namespace {
+
+uint32_t ParseHex(const std::string& text, const std::string& spec) {
+    std::string digits = text;
+    if (digits.rfind("0x", 0) == 0 || digits.rfind("0X", 0) == 0) digits = digits.substr(2);
+    size_t used = 0;
+    unsigned long long value = 0;
+    bool ok = !digits.empty() && digits.find_first_not_of("0123456789abcdefABCDEF") == std::string::npos;
+    try { if (ok) value = std::stoull(digits, &used, 16); } catch (const std::exception&) { ok = false; }
+    if (!ok || used != digits.size() || value > 0xFFFFFFFFull)
+        throw std::runtime_error("Invalid --watch-writes range (LO-HI, LO+LEN or LO, hex): " + spec);
+    return static_cast<uint32_t>(value);
+}
+
+const char* Widths(uint32_t mask) {
+    static const char* const names[16] = {
+        "-",      "8",      "16",      "8/16",      "32",      "8/32",      "16/32",      "8/16/32",
+        "host",   "8+host", "16+host", "8/16+host", "32+host", "8/32+host", "16/32+host", "all",
+    };
+    return names[mask & 15];
+}
+
+}  // namespace
+
+WriteWatch::Range WriteWatch::ParseRange(const std::string& spec) {
+    Range range;
+    range.text = spec;
+    const size_t dash = spec.find('-'), plus = spec.find('+');
+    if (dash != std::string::npos) {
+        range.lo = ParseHex(spec.substr(0, dash), spec);
+        range.hi = ParseHex(spec.substr(dash + 1), spec);
+    } else if (plus != std::string::npos) {
+        range.lo = ParseHex(spec.substr(0, plus), spec);
+        const uint32_t length = ParseHex(spec.substr(plus + 1), spec);
+        if (length == 0) throw std::runtime_error("Empty --watch-writes range: " + spec);
+        range.hi = static_cast<uint32_t>(std::min<uint64_t>(uint64_t(range.lo) + length - 1, 0xFFFFFFFFull));
+    } else {
+        range.lo = ParseHex(spec, spec);
+        range.hi = static_cast<uint32_t>(std::min<uint64_t>(uint64_t(range.lo) + 3, 0xFFFFFFFFull));
+    }
+    if (range.hi < range.lo) throw std::runtime_error("Inverted --watch-writes range: " + spec);
+    return range;
+}
+
+void WriteWatch::Install(BlackFinCpu& cpu) {
+    livePrinted_.assign(ranges_.size(), 0);
+    for (size_t i = 0; i < ranges_.size(); ++i) {
+        const Range& range = ranges_[i];
+        cpu.GetEmulator().AddWriteTrace(range.lo, range.hi, [this, &cpu, i](uint32_t addr, uint32_t length, uint32_t value) {
+            OnStore(i, cpu.PC(), cpu.Time().Nanoseconds(), addr, length, value);
+        });
+        fprintf(stderr, "[watch] %s: tracing stores to 0x%08x..0x%08x\n", range.text.c_str(), range.lo, range.hi);
+    }
+}
+
+void WriteWatch::OnStore(size_t range, uint32_t pc, uint64_t ns, uint32_t addr, uint32_t length, uint32_t value) {
+    const uint32_t widthBit = length == 1 ? 1 : length == 2 ? 2 : length == 4 ? 4 : 8;
+    if (logMax_ && ns >= logFromNs_ && logged_ < logMax_) {
+        ++logged_;
+        fprintf(stderr, "[watch] store t=%.6fs pc=0x%08x addr=0x%08x width=%u value=0x%08x (%s)\n", ns / 1e9, pc, addr,
+                length, value, ranges_[range].text.c_str());
+    }
+    auto [it, fresh] = writers_.try_emplace({range, pc});
+    Writer& w = it->second;
+    if (fresh) {
+        w.order = order_++;
+        w.minAddr = w.maxAddr = w.firstAddr = addr;
+        w.firstValue = value;
+        w.firstNs = ns;
+        if (livePrinted_[range]++ < kLivePcs)
+            fprintf(stderr, "[watch] %s: writer #%llu pc=0x%08x addr=0x%08x width=%u value=0x%08x t=%.4fs\n",
+                    ranges_[range].text.c_str(), static_cast<unsigned long long>(w.order), pc, addr, length, value,
+                    ns / 1e9);
+    }
+    ++w.stores;
+    if (value != 0) {
+        if (w.nonzero++ == 0) w.firstNonzeroNs = ns;
+        w.lastNonzeroNs = ns;
+    }
+    w.widths |= widthBit;
+    w.minAddr = std::min(w.minAddr, addr);
+    w.maxAddr = std::max(w.maxAddr, addr);
+    w.lastAddr = addr;
+    w.lastValue = value;
+    w.lastNs = ns;
+}
+
+void WriteWatch::Report(const std::string& path) const {
+    std::vector<std::pair<const std::pair<size_t, uint32_t>*, const Writer*>> rows;
+    for (const auto& [key, writer] : writers_) rows.push_back({&key, &writer});
+    std::sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) {
+        if (a.first->first != b.first->first) return a.first->first < b.first->first;
+        return a.second->order < b.second->order;
+    });
+    FILE* file = path.empty() ? nullptr : fopen(path.c_str(), "w");
+    if (!path.empty() && !file) fprintf(stderr, "[watch] cannot write %s\n", path.c_str());
+    auto both = [&](const char* line) {
+        fputs(line, stderr);
+        if (file) fputs(line, file);
+    };
+    char line[512];
+    both("range\tpc\tstores\tnonzero\twidths\tmin_addr\tmax_addr\tfirst_addr\tfirst_value\tlast_addr\tlast_value\t"
+         "first_s\tlast_s\tfirst_nonzero_s\tlast_nonzero_s\n");
+    for (const auto& [key, w] : rows) {
+        snprintf(line, sizeof line,
+                 "%s\t0x%08x\t%llu\t%llu\t%s\t0x%08x\t0x%08x\t0x%08x\t0x%08x\t0x%08x\t0x%08x\t%.4f\t%.4f\t%.4f\t%.4f\n",
+                 ranges_[key->first].text.c_str(), key->second, static_cast<unsigned long long>(w->stores),
+                 static_cast<unsigned long long>(w->nonzero), Widths(w->widths), w->minAddr, w->maxAddr, w->firstAddr,
+                 w->firstValue, w->lastAddr, w->lastValue, w->firstNs / 1e9, w->lastNs / 1e9, w->firstNonzeroNs / 1e9,
+                 w->lastNonzeroNs / 1e9);
+        both(line);
+    }
+    for (size_t i = 0; i < ranges_.size(); ++i) {
+        size_t writers = 0;
+        uint64_t stores = 0;
+        for (const auto& [key, w] : writers_)
+            if (key.first == i) { ++writers; stores += w.stores; }
+        snprintf(line, sizeof line, "# %s: %zu writer PC(s), %llu store(s)\n", ranges_[i].text.c_str(), writers,
+                 static_cast<unsigned long long>(stores));
+        both(line);
+    }
+    if (file) fclose(file);
+}
diff --git a/gui/write_watch.h b/gui/write_watch.h
new file mode 100755
index 0000000..c049772
--- /dev/null
+++ b/gui/write_watch.h
@@ -0,0 +1,66 @@
+#pragma once
+
+// --watch-writes: who stores into a guest address range. One Emulator write
+// trace per range (Emulator::AddWriteTrace) records, per storing PC, how many
+// stores landed in the range, their widths, the addresses and values of the
+// first and last and the guest time of each, prints each new PC as it first
+// appears (up to kLivePcs per range, so an aborted run still tells) and a
+// table at exit. Works in every build; it needs no profiling support.
+//
+// The PC is bcore's CpuState::pc at the callback: the packet of the storing
+// instruction (bcore materializes pc before every memory callback). A store
+// the host makes (DMA, the LDR loader) is attributed to whatever PC the CPU
+// state holds then; a trace on a DMA target shows that as a wide width.
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+
+class BlackFinCpu;
+
+class WriteWatch {
+public:
+    struct Range {
+        uint32_t lo = 0, hi = 0;
+        std::string text;  // as given on the command line
+    };
+    // "LO-HI" (inclusive), "LO+LEN" or "LO" (one word of 4 bytes); hex, "0x"
+    // optional. Throws std::runtime_error on a bad spec.
+    static Range ParseRange(const std::string& spec);
+
+    void Add(Range range) { ranges_.push_back(std::move(range)); }
+    bool Empty() const { return ranges_.empty(); }
+    // Installs the traces on cpu's emulator; cpu gives the PC and guest time.
+    // Before the CPU runs.
+    void Install(BlackFinCpu& cpu);
+    // The table, to stderr and, if path is nonempty, to that file (TSV with a
+    // header line). After the CPU thread ended.
+    void Report(const std::string& path) const;
+
+    // Also print the first `count` individual stores at or after guest time
+    // fromNs, one line each: the order of the writers inside a block.
+    void LogStores(uint64_t fromNs, uint64_t count) { logFromNs_ = fromNs; logMax_ = count; }
+
+    static constexpr size_t kLivePcs = 64;
+
+private:
+    struct Writer {
+        uint64_t order = 0;  // 0-based: the order PCs first appeared in, over every range
+        uint64_t stores = 0;
+        uint64_t nonzero = 0;  // stores of a value other than 0: whether this writer carried signal
+        uint32_t widths = 0;  // bit 0: 1 byte, 1: 2, 2: 4, 3: wider (a host write)
+        uint32_t minAddr = 0, maxAddr = 0;
+        uint32_t firstAddr = 0, firstValue = 0, lastAddr = 0, lastValue = 0;
+        uint64_t firstNs = 0, lastNs = 0;
+        uint64_t firstNonzeroNs = 0, lastNonzeroNs = 0;  // guest time of the first and last nonzero store
+    };
+    void OnStore(size_t range, uint32_t pc, uint64_t ns, uint32_t addr, uint32_t length, uint32_t value);
+
+    std::vector<Range> ranges_;
+    std::vector<size_t> livePrinted_;
+    std::map<std::pair<size_t, uint32_t>, Writer> writers_;  // (range index, pc)
+    uint64_t order_ = 0;
+    uint64_t logFromNs_ = 0, logMax_ = 0, logged_ = 0;
+};
