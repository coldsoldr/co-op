From 50a568162e6694d25896d4ded4eca9eaa1bfa44b Mon Sep 17 00:00:00 2001
From: root <root@Caladan.localdomain>
Date: Mon, 2 Nov 2026 10:28:27 +0200
Subject: [PATCH 2/2] audio dump/playback: two words per frame are L and R even
 without a stereo frame sync (OP-1)

---
 gui/audio_output_wav.cpp | 6 ++++--
 gui/audio_pcm.h          | 3 ++-
 2 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/gui/audio_output_wav.cpp b/gui/audio_output_wav.cpp
index b75123f..7da09ac 100755
--- a/gui/audio_output_wav.cpp
+++ b/gui/audio_output_wav.cpp
@@ -55,7 +55,7 @@ void WavAudioOutput::WriteSamples(const void* data, size_t samples, int channels
     if (!formatLogged_) {
         formatLogged_ = true;
         LogInfo("Audio dump: SPORT frames of %d word(s) x %d bits, %s", channels, bitsPerSample,
-                stereo ? "stereo frame sync" : "no stereo frame sync");
+                stereo ? "stereo frame sync" : "no stereo frame sync (word 1 taken as right)");
     }
     const bool wide = bitsPerSample > 16;
     const size_t wordBytes = wide ? 4 : 2;
@@ -72,7 +72,9 @@ void WavAudioOutput::WriteSamples(const void* data, size_t samples, int channels
     };
     for (size_t i = 0; i < samples; ++i) {
         const int16_t l = word(i, 0);
-        const int16_t r = (stereo && channels >= 2) ? word(i, 1) : l;
+        // Two words per frame carry left and right whether or not the frame sync is the stereo kind:
+        // the OP-1 firmware writes L to word 0 and R to word 1 of each frame (TSFSE = 0).
+        const int16_t r = channels >= 2 ? word(i, 1) : l;
         Put16(&out[i * 4], uint16_t(l));
         Put16(&out[i * 4 + 2], uint16_t(r));
         if (l != 0 || r != 0) ++nonzero_;
diff --git a/gui/audio_pcm.h b/gui/audio_pcm.h
index f66fb6a..9f9543c 100644
--- a/gui/audio_pcm.h
+++ b/gui/audio_pcm.h
@@ -31,6 +31,7 @@ inline void PcmToStereo(const void* data, size_t frames, int words, int bits, bo
     for (size_t i = 0; i < frames; ++i) {
         const uint8_t* frame = src + i * stride;
         out[2 * i] = sample(frame);
-        out[2 * i + 1] = stereo && words >= 2 ? sample(frame + wordSize * size_t(words / 2)) : out[2 * i];
+        // two words per frame: the second is the right channel even without a stereo frame sync (OP-1)
+        out[2 * i + 1] = words >= 2 ? sample(frame + wordSize * size_t(words / 2)) : out[2 * i];
     }
 }
-- 
