+// ---- coop-fw (patch 0003): encoders and the volume knob by drag and wheel; a click on an encoder is its push ----
+// A drag up or to the right turns clockwise: one Gray transition (one KeyHandler::AddKnob(+-1), half a detent) per
+// kPixelsPerStep of movement. The transitions go out a few per frame, kStepNs apart in guest time (the firmware reads
+// each edge in its GPIO interrupt; edges sent at once would be missed).
+static constexpr double kPixelsPerStep = 4.0;
+static constexpr int kStepsPerFrame = 4;
+static constexpr uint64_t kStepNs = 2000000;   // 2 ms
+
+int GLFWDisplay::EncoderAt(double x, double y) const {
+    for (size_t e = 0; e < uiConfig_.encoders.size() && e < 4; e++) {
+        const auto& cw = std::get<0>(uiConfig_.encoders[e]);
+        const auto& ccw = std::get<1>(uiConfig_.encoders[e]);
+        const int left = std::min(cw.left, ccw.left), right = std::max(cw.left + cw.width, ccw.left + ccw.width);
+        const int top = std::min(cw.top, ccw.top), bottom = std::max(cw.top + cw.height, ccw.top + ccw.height);
+        if (x >= left && x < right && y >= top && y < bottom) return int(e);
+    }
+    const auto& v = uiConfig_.volumeKnob;
+    const int vl = std::min(v.clockwiseLeft, v.counterClockwiseLeft);
+    const int vr = std::max(v.clockwiseLeft + v.clockwiseWidth, v.counterClockwiseLeft + v.counterClockwiseWidth);
+    const int vt = std::min(v.clockwiseTop, v.counterClockwiseTop);
+    const int vb = std::max(v.clockwiseTop + v.clockwiseHeight, v.counterClockwiseTop + v.counterClockwiseHeight);
+    if (x >= vl && x < vr && y >= vt && y < vb) return 4;
+    return -1;
+}
+
+const ButtonConfig* GLFWDisplay::ButtonNamed(const std::string& name) const {
+    for (const auto& b : uiConfig_.buttons) if (b.name == name) return &b;
+    return nullptr;
+}
+
+void GLFWDisplay::StepEncoders() {
+    constexpr int seq[] = {0, 2, 3, 1};
+    for (size_t e = 0; e < uiConfig_.encoders.size() && e < 4; e++) {
+        auto& [cw, ccw, index] = uiConfig_.encoders[e];
+        for (int k = 0; k < kStepsPerFrame && pendingSteps_[e]; k++) {
+            const int dir = pendingSteps_[e] > 0 ? 1 : -1;
+            pendingSteps_[e] -= dir;
+            index = uint8_t((index + (dir > 0 ? 1 : 3)) % 4);
+            const int value = seq[index];
+            OnKeyAt(cw.bank, cw.index, (value & 2) != 0, uint64_t(k) * kStepNs);
+            OnKeyAt(ccw.bank, ccw.index, (value & 1) != 0, uint64_t(k) * kStepNs);
+        }
+    }
+}
+
+void GLFWDisplay::CursorPosCallback(GLFWwindow* window, double x, double y) {
+    auto* display = static_cast<GLFWDisplay*>(glfwGetWindowUserPointer(window));
+    if (display) display->HandleCursor(x, y);
+}
+
+void GLFWDisplay::ScrollCallback(GLFWwindow* window, double dx, double dy) {
+    auto* display = static_cast<GLFWDisplay*>(glfwGetWindowUserPointer(window));
+    if (display) display->HandleScroll(dx, dy);
+}
+
+void GLFWDisplay::HandleCursor(double x, double y) {
+    if (drag_.which < 0) return;
+    const double d = (x - drag_.x) - (y - drag_.y);   // right or up: clockwise
+    drag_.x = x; drag_.y = y;
+    if (std::abs(x - drag_.x0) + std::abs(y - drag_.y0) > 3) drag_.moved = true;
+    if (drag_.which == 4) {                           // the volume knob: 0..255
+        int v = int(volumeValue_) + int(d);
+        volumeValue_ = uint8_t(v < 0 ? 0 : v > 255 ? 255 : v);
+        return;
+    }
+    drag_.acc += d;
+    while (drag_.acc >= kPixelsPerStep) { pendingSteps_[drag_.which]++; drag_.acc -= kPixelsPerStep; }
+    while (drag_.acc <= -kPixelsPerStep) { pendingSteps_[drag_.which]--; drag_.acc += kPixelsPerStep; }
+}
+
+void GLFWDisplay::HandleScroll(double dx, double dy) {
+    (void)dx;
+    double x, y;
+    glfwGetCursorPos(window_, &x, &y);
+    const int e = EncoderAt(x, y);
+    if (e < 0 || dy == 0) return;
+    const int notches = dy > 0 ? 1 : -1;              // one detent (two transitions) per wheel notch
+    if (e == 4) {
+        int v = int(volumeValue_) + 8 * notches;
+        volumeValue_ = uint8_t(v < 0 ? 0 : v > 255 ? 255 : v);
+    } else {
+        pendingSteps_[e] += 2 * notches;
+    }
+}
