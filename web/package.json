{
  "name": "@co-op/web",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx scripts/packs.ts build dist && tsx scripts/plugins.ts build dist",
    "packs:validate": "tsx scripts/packs.ts validate",
    "plugins:validate": "tsx scripts/plugins.ts validate",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures": "tsx test/fixtures/build-fixtures.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@co-op/shared": "workspace:*",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
